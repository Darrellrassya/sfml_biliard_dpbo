{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run Billiard 2D (Multi-OS)",
            "type": "shell",
            "osx": {
                "command": "g++ -std=c++17 src/*.cpp -Iinclude -I/usr/local/include -I/opt/homebrew/include -L/usr/local/lib -L/opt/homebrew/lib -lsfml-graphics -lsfml-window -lsfml-system -o app && ./app"
            },
            "windows": {
                "command": "g++ -std=c++17 src/*.cpp -Iinclude -IC:/SFML/include -LC:/SFML/lib -lsfml-graphics -lsfml-window -lsfml-system -o app.exe ; if ($?) { ./app.exe }"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "osx": {
                "command": "/usr/bin/g++",
                "args": [
                    "-std=c++17",
                    "-g",
                    "${fileDirname}/*.cpp",
                    "-I${fileDirname}/../include",
                    "-I/usr/local/include",
                    "-I/opt/homebrew/include",
                    "-L/usr/local/lib",
                    "-L/opt/homebrew/lib",
                    "-lsfml-graphics",
                    "-lsfml-window",
                    "-lsfml-system",
                    "-o",
                    "${fileDirname}/../app"
                ]
            },
            "windows": {
                "command": "g++",
                "args": [
                    "-std=c++17",
                    "-g",
                    "${fileDirname}/*.cpp",
                    "-I${fileDirname}/../include",
                    "-IC:/SFML/include",
                    "-LC:/SFML/lib",
                    "-lsfml-graphics",
                    "-lsfml-window",
                    "-lsfml-system",
                    "-o",
                    "${fileDirname}/../app.exe"
                ]
            },
            "options": {
                "cwd": "${fileDirname}/.."
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Multi-OS Play Button (Mac & Windows)"
        },
        {
            "type": "shell",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}