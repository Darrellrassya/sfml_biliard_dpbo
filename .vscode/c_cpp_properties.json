{
    "configurations": [
        {
            "name": "Mac",
            "includePath": ["${workspaceFolder}/**", "${workspaceFolder}/include", "/usr/local/include/**", "/opt/homebrew/include/**"],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-x64"
        },
        {
            "name": "Win32",
            "includePath": ["${workspaceFolder}/**", "${workspaceFolder}/include", "C:/SFML/include/**"],
            "compilerPath": "C:/mingw64/bin/g++.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}
